# Database
POSTGRES_DB=pairup
POSTGRES_USER=pairup
POSTGRES_PASSWORD=pairup
POSTGRES_HOST=
POSTGRES_PORT=5432
DB_ENGINE=sqlite

# Redis / Channels
REDIS_URL=
USE_INMEMORY_CHANNEL_LAYER=True

# Django local demo
DJANGO_SECRET_KEY=replace-with-your-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.x.x.x
SERVE_MEDIA_FILES=True
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=CampusClaw <no-reply@campusclaw.local>
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60

# WeChat mini program
WECHAT_MINIAPP_APPID=replace-with-your-wechat-appid
WECHAT_MINIAPP_SECRET=replace-with-your-wechat-secret

# AI agent
AGENT_API_KEY=replace-with-your-agent-api-key
AGENT_BASE_URL=https://example.com/v1/chat/completions
AGENT_MODEL=replace-with-your-model-name
